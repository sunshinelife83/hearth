{
  "name": "@sunshinelife83/hearth",
  "version": "1.2.0",
  "description": "Expose a secure local coding workspace through an MCP server.",
  "keywords": [],
  "homepage": "https://github.com/sunshinelife83/hearth#readme",
  "bugs": {
    "url": "https://github.com/sunshinelife83/hearth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunshinelife83/hearth.git"
  },
  "license": "MIT",
  "author": "Mounib Bouchareb <mounib.bouchareb16@gmail.com>",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "hearth": "bin/hearth.js",
    "hearth-agentd": "bin/hearth-agentd.js"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "examples",
    "schema",
    "scripts",
    "skills",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && pnpm build:app && pnpm build:dashboard && tsc -p tsconfig.build.json",
    "build:dashboard": "node scripts/copy-dashboard.mjs",
    "build:app": "vite build",
    "dev": "tsx watch --clear-screen=false src/cli.ts serve",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "prepack": "pnpm build",
    "schema:config": "tsx scripts/generate-config-schema.ts",
    "start": "node dist/cli.js serve",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:ci-tunnel": "tsx --test --test-concurrency=1 \"src/tunnel-ngrok.test.ts\" \"src/cli-ngrok.test.ts\" \"src/tunnel-host-gate.test.ts\" \"src/cli-id.test.ts\" \"src/host-compat.test.ts\"",
    "test:ci-config": "tsx --test --test-concurrency=1 \"src/config.test.ts\" \"src/config-schema.test.ts\" \"src/user-config.test.ts\" \"src/test-support/config.test.ts\" \"src/machine-id.test.ts\" \"src/onboarding.test.ts\" \"src/cli-workspace.test.ts\" \"src/request-meta.test.ts\" \"src/process-platform.test.ts\" \"src/roots.test.ts\"",
    "test:ci-server": "tsx --test --test-concurrency=1 \"src/server.test.ts\" \"src/mcp-modern-server.test.ts\" \"src/stdio-server.test.ts\" \"src/server-shutdown.test.ts\" \"src/dashboard.test.ts\"",
    "test:ci-server-server": "tsx --test --test-concurrency=1 \"src/server.test.ts\"",
    "test:ci-server-modern": "tsx --test --test-concurrency=1 \"src/mcp-modern-server.test.ts\"",
    "test:ci-server-stdio": "tsx --test --test-concurrency=1 \"src/stdio-server.test.ts\"",
    "test:ci-server-shutdown": "tsx --test --test-concurrency=1 \"src/server-shutdown.test.ts\"",
    "test:ci-server-dashboard": "tsx --test --test-concurrency=1 \"src/dashboard.test.ts\"",
    "test:ci-cli": "tsx --test --test-concurrency=1 \"src/cli.test.ts\" \"src/cli-show-changes.test.ts\" \"src/bin-launcher.test.ts\"",
    "test:ci-state": "tsx --test --test-concurrency=1 \"src/oauth-store.test.ts\" \"src/device-tokens.test.ts\" \"src/task-runtime.test.ts\" \"src/agent-task-link.test.ts\" \"src/workspace-conversation.test.ts\" \"src/workspaces.test.ts\" \"src/review-checkpoints.test.ts\" \"src/snapshot-manager.test.ts\" \"src/skills.test.ts\" \"src/apply-patch.test.ts\" \"src/artifact-download.test.ts\" \"src/incoming-artifacts.test.ts\"",
    "test:ci-policy": "tsx --test --test-concurrency=1 \"src/policy/command-policy.test.ts\" \"src/policy/env-allowlist.test.ts\" \"src/policy/sandbox.test.ts\" \"src/policy/shell-gate.test.ts\" \"src/policy/workspace-profiles.test.ts\" \"src/process-sessions.test.ts\" \"src/process-journal.test.ts\"",
    "test:ci-agents": "tsx --test --test-concurrency=1 \"src/local-agent-*.test.ts\" \"src/orchestration/*.test.ts\" \"src/context/*.test.ts\" \"src/ui/*.test.ts\"",
    "test:package-install": "tsx --test --test-concurrency=1 \"test/package-install-smoke.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.200",
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opencode-ai/sdk": "^1.17.13",
    "@pierre/diffs": "^1.3.6",
    "better-result": "^2.10.0",
    "better-sqlite3": "^13.0.3",
    "cross-spawn": "^7.0.6",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "lucide": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "engines": {
    "node": ">=22.19 <27"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "protobufjs": "7.6.4",
    "ws": "8.21.0",
    "undici": "8.5.0"
  },
  "packageManager": "pnpm@11.25.0"
}
