# Hearth environment variables
#
# Only the variables below are read by Hearth (v1.1+). All durable settings
# (host, port, allowedRoots, publicBaseUrl, tools, skills, logging, ...) live
# in ~/.hearth/config.jsonc — see docs/configuration.md.

# Owner password. Generated by `hearth init` into ~/.hearth/auth.json.
# Set this only for non-interactive or fully env-driven deployments
# (minimum 16 characters, prefer a long random value). When provided via env,
# keep in mind commands executed by Hearth tools run under your user and
# Hearth filters the environment they inherit; still avoid weak values.
# HEARTH_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret

# Override the config directory (default: ~/.hearth).
# HEARTH_CONFIG_DIR=

# Used by `hearth agents` CLI commands to attach to a running server's
# workspace instead of the local git checkout. Only honored together.
# HEARTH_WORKSPACE_ID=
# HEARTH_WORKSPACE_ROOT=

# Local agent daemon tuning (milliseconds).
# HEARTH_AGENTD_IDLE_TIMEOUT_MS=30000
# HEARTH_AGENTD_SHUTDOWN_TIMEOUT_MS=10000
